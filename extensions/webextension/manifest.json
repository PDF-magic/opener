{
  "manifest_version": 3,
  "name": "PDF Magic Opener",
  "version": "0.1.0",
  "incognito": "not_allowed",
  "description": "PDF Magic Opener browser integration scaffold. Not active; cannot scan, sanitize, or open PDF files.",
  "permissions": [],
  "host_permissions": [],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "PDF Magic Opener (not active)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup.html"
  },
  "optional_permissions": [
    "downloads"
  ]
}
